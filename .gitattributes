# Normalize line endings: store as LF in the repo, check out as native on each OS
* text=auto eol=lf

# Windows scripts — keep CRLF on Windows checkouts
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.exe   binary
*.dll   binary
*.so    binary
*.pyc   binary
*.pyo   binary
